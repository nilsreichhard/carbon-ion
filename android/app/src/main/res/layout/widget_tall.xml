<?xml version="1.0" encoding="utf-8"?>
<!-- TALL (4+ cells): 85 (rain +12) | 90 | 9 + 86 = 270 rows.
     Rows follow the watch grid (src/c/main.c, time_layer.h); the chart bitmap
     fills the widget and text sizes are set in code (WidgetUpdater). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/chart"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/widget_description" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="85" />

        <FrameLayout
            android:id="@+id/time_block"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="90">

            <!-- City row, clock and date come from the font layouts
                 (text_*.xml, clock_*.xml), added by WidgetUpdater. -->
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="95" />
    </LinearLayout>
</FrameLayout>
