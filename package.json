{
  "name": "carbon-ion",
  "description": "High-precision weather graph watchface for Pebble Time 2 (Emery) and Round 2 (Gabbro), based on Carbon by Cory Hughart.",
  "author": {
    "name": "Nils Reich",
    "url": "https://github.com/nilsreichhard/carbon-ion"
  },
  "version": "2.0.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "pebble": {
    "displayName": "Carbon Ion",
    "uuid": "b3e351bb-53f8-4af7-8b98-9b44da3bad50",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery"
    ],
    "watchapp": {
      "watchface": true
    },
    "capabilities": [
      "location",
      "configurable"
    ],
    "messageKeys": [
      "WEATHER_REQUEST",
      "WEATHER_TEMP",
      "WEATHER_TEMP_HIGH",
      "WEATHER_TEMP_LOW",
      "WEATHER_CODE",
      "WEATHER_PRECIP_PROB",
      "WEATHER_TEMP_HOURLY",
      "WEATHER_APPARENT_TEMP_HOURLY",
      "WEATHER_CLOUD_COVER",
      "WEATHER_HOURLY_CODE",
      "WEATHER_SUNRISE_HOUR",
      "WEATHER_SUNSET_HOUR",
      "WEATHER_FETCH_TIME",
      "CITY_NAME",
      "SETTING_TEMP_UNIT",
      "SETTING_FETCH_INTERVAL",
      "SETTING_ACCENT_COLOR",
      "SETTING_DATE_FORMAT",
      "SETTING_BATTERY_DISPLAY",
      "SETTING_SHOW_TIMEZONE",
      "SETTING_GEOCODE_ENABLED",
      "SETTING_LOCATION_OVERRIDE",
      "SETTING_USE_STATIC_LOCATION",
      "SETTING_STATIC_LAT",
      "SETTING_STATIC_LON",
      "SETTING_CLEAR_CACHE",
      "SETTING_INFILL_MODE",
      "SETTING_NEEDLE_MODE",
      "SETTING_FORECAST_HOURS",
      "SETTING_LIGHT_THEME",
      "SETTING_SHOW_BT_ALERT",
      "SETTING_SHOW_SILENT_MODE",
      "SETTING_TIMELINE_BATTERY"
    ],
    "resources": {
      "media": [
        {
          "type": "font",
          "name": "CARBON_ICONS_12",
          "file": "fonts/IcoMoon-Regular.ttf",
          "characterRegex": "[\\uE000-\\uF9FF]"
        },
        {
          "type": "font",
          "name": "CARBON_ICONS_14",
          "file": "fonts/IcoMoon-Regular.ttf",
          "characterRegex": "[\\uE000-\\uF9FF]"
        },
        {
          "type": "font",
          "name": "CARBON_ICONS_18",
          "file": "fonts/IcoMoon-Regular.ttf",
          "characterRegex": "[\\uE000-\\uF9FF]"
        },
        {
          "type": "font",
          "name": "CARBON_ICONS_22",
          "file": "fonts/IcoMoon-Regular.ttf",
          "characterRegex": "[\\uE000-\\uF9FF]"
        }
      ]
    }
  },
  "scripts": {
    "gen-icons": "node scripts/gen-icons.js"
  },
  "dependencies": {
    "@rebble/clay": "^1.0.10"
  }
}